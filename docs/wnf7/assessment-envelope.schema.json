{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourceenergyglobal.com/schemas/wnf7/assessment-envelope.schema.json",
  "title": "WNF-7 Assessment Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "component_code",
    "profile_code",
    "observed_at",
    "dimensions",
    "dimension_results",
    "automated_state",
    "decision_eligibility",
    "blocking_dimensions",
    "review_dimensions",
    "recommended_reviewer_roles",
    "human_review_required",
    "input_sha256",
    "output_sha256",
    "evaluator_version",
    "execution_command"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "component_code": {
      "enum": [
        "SETC",
        "SOURCECUBE",
        "CODEX_VERITAS",
        "SOURCEONE",
        "SIOS",
        "SIDEKICK_OEL",
        "SOURCECOIN",
        "SOURCEBLOCK"
      ]
    },
    "profile_code": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "dimensions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "FEAR",
          "PRESENCE",
          "WISDOM",
          "KNOWLEDGE",
          "UNDERSTANDING",
          "COUNSEL",
          "MIGHT_POWER"
        ]
      }
    },
    "dimension_results": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/dimensionResult"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "FEAR"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "PRESENCE"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "WISDOM"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "KNOWLEDGE"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "UNDERSTANDING"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "COUNSEL"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "MIGHT_POWER"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "automated_state": {
      "enum": [
        "PASS",
        "REVIEW",
        "BLOCKED"
      ]
    },
    "decision_eligibility": {
      "enum": [
        "ELIGIBLE_FOR_HUMAN_DECISION",
        "SIMULATION_ONLY",
        "NOT_ELIGIBLE"
      ]
    },
    "blocking_dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dimensionCode"
      }
    },
    "review_dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dimensionCode"
      }
    },
    "recommended_reviewer_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "authority_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_command": {
      "type": "null"
    },
    "human_review_required": {
      "const": true
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "default": {}
    }
  },
  "$defs": {
    "dimensionCode": {
      "enum": [
        "FEAR",
        "PRESENCE",
        "WISDOM",
        "KNOWLEDGE",
        "UNDERSTANDING",
        "COUNSEL",
        "MIGHT_POWER"
      ]
    },
    "dimensionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "status",
        "finding",
        "evidence_refs",
        "control_refs",
        "owner_role",
        "reviewed_at"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/dimensionCode"
        },
        "status": {
          "enum": [
            "PASS",
            "REVIEW",
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "control_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner_role": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "not_applicable_reason": {
          "type": "string",
          "minLength": 1
        },
        "approving_authority_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_APPLICABLE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "not_applicable_reason",
              "approving_authority_ref"
            ]
          }
        }
      ]
    }
  }
}
