{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourceenergyglobal.com/schemas/wnf7/assessment-envelope.schema.json",
  "title": "WNF-7 Assessment Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "component_code",
    "profile_code",
    "adapter_code",
    "adapter_version",
    "operation_code",
    "consequence_class",
    "observed_at",
    "dimensions",
    "dimension_results",
    "automated_state",
    "decision_eligibility",
    "blocking_dimensions",
    "review_dimensions",
    "recommended_reviewer_roles",
    "human_review_required",
    "input_sha256",
    "output_sha256",
    "evaluator_version",
    "execution_command"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "component_code": {
      "enum": [
        "SETC",
        "SOURCECUBE",
        "CODEX_VERITAS",
        "SOURCEONE",
        "SIOS",
        "SIDEKICK_OEL",
        "SOURCECOIN",
        "SOURCEBLOCK"
      ]
    },
    "profile_code": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "adapter_code": {
      "enum": [
        "WNF7-ADAPTER-SETC-001",
        "WNF7-ADAPTER-SOURCECUBE-001",
        "WNF7-ADAPTER-CODEX_VERITAS-001",
        "WNF7-ADAPTER-SOURCEONE-001",
        "WNF7-ADAPTER-SIOS-001",
        "WNF7-ADAPTER-SIDEKICK_OEL-001",
        "WNF7-ADAPTER-SOURCECOIN-001",
        "WNF7-ADAPTER-SOURCEBLOCK-001"
      ]
    },
    "adapter_version": {
      "const": "wnf7-adapter-1.0"
    },
    "operation_code": {
      "enum": [
        "AUTHORITY_REVIEW",
        "POLICY_DECISION",
        "RELEASE_GATE_REVIEW",
        "CONTEXT_CLASSIFICATION",
        "EVIDENCE_SYNTHESIS",
        "ADVISORY_PLAN",
        "CLAIM_ASSESSMENT",
        "CONTRADICTION_REVIEW",
        "PUBLICATION_REVIEW",
        "HUMAN_ACTION_REVIEW",
        "APPROVAL_CONTEXT",
        "OUTCOME_EXPLANATION",
        "WORKFLOW_TRANSITION_REVIEW",
        "CROSS_DOMAIN_HANDOFF",
        "RELEASE_READINESS",
        "WORK_ITEM_INTAKE",
        "DELEGATION_REVIEW",
        "OUTCOME_REVIEW",
        "ECONOMIC_ELIGIBILITY",
        "TRANSFER_ELIGIBILITY",
        "SETTLEMENT_ELIGIBILITY",
        "LIFECYCLE_GATE",
        "VALUE_EVIDENCE_REVIEW",
        "CLOSURE_REVIEW"
      ]
    },
    "consequence_class": {
      "enum": [
        "INFORMATIONAL",
        "ADVISORY",
        "OPERATIONAL",
        "CONSEQUENTIAL"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "dimensions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "FEAR",
          "PRESENCE",
          "WISDOM",
          "KNOWLEDGE",
          "UNDERSTANDING",
          "COUNSEL",
          "MIGHT_POWER"
        ]
      }
    },
    "dimension_results": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/dimensionResult"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "FEAR"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "PRESENCE"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "WISDOM"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "KNOWLEDGE"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "UNDERSTANDING"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "COUNSEL"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "dimension": {
                "const": "MIGHT_POWER"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "automated_state": {
      "enum": [
        "PASS",
        "REVIEW",
        "BLOCKED"
      ]
    },
    "decision_eligibility": {
      "enum": [
        "ELIGIBLE_FOR_HUMAN_DECISION",
        "SIMULATION_ONLY",
        "NOT_ELIGIBLE"
      ]
    },
    "blocking_dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dimensionCode"
      }
    },
    "review_dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dimensionCode"
      }
    },
    "recommended_reviewer_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "authority_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_command": {
      "type": "null"
    },
    "human_review_required": {
      "const": true
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "default": {}
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "component_code": { "const": "SETC" },
            "profile_code": { "const": "SETC-PROFILE-7D-001" },
            "adapter_code": { "const": "WNF7-ADAPTER-SETC-001" },
            "operation_code": { "enum": ["AUTHORITY_REVIEW", "POLICY_DECISION", "RELEASE_GATE_REVIEW"] }
          }
        },
        {
          "properties": {
            "component_code": { "const": "SOURCECUBE" },
            "profile_code": { "const": "SOURCECUBE-PROFILE-7D-001" },
            "adapter_code": { "const": "WNF7-ADAPTER-SOURCECUBE-001" },
            "operation_code": { "enum": ["CONTEXT_CLASSIFICATION", "EVIDENCE_SYNTHESIS", "ADVISORY_PLAN"] }
          }
        },
        {
          "properties": {
            "component_code": { "const": "CODEX_VERITAS" },
            "profile_code": { "const": "CODEX-VERITAS-PROFILE-7D-001" },
            "adapter_code": { "const": "WNF7-ADAPTER-CODEX_VERITAS-001" },
            "operation_code": { "enum": ["CLAIM_ASSESSMENT", "CONTRADICTION_REVIEW", "PUBLICATION_REVIEW"] }
          }
        },
        {
          "properties": {
            "component_code": { "const": "SOURCEONE" },
            "profile_code": { "const": "SOURCEONE-PROFILE-7D-001" },
            "adapter_code": { "const": "WNF7-ADAPTER-SOURCEONE-001" },
            "operation_code": { "enum": ["HUMAN_ACTION_REVIEW", "APPROVAL_CONTEXT", "OUTCOME_EXPLANATION"] }
          }
        },
        {
          "properties": {
            "component_code": { "const": "SIOS" },
            "profile_code": { "const": "SIOS-PROFILE-7D-001" },
            "adapter_code": { "const": "WNF7-ADAPTER-SIOS-001" },
            "operation_code": { "enum": ["WORKFLOW_TRANSITION_REVIEW", "CROSS_DOMAIN_HANDOFF", "RELEASE_READINESS"] }
          }
        },
        {
          "properties": {
            "component_code": { "const": "SIDEKICK_OEL" },
            "profile_code": { "const": "SIDEKICK-OEL-PROFILE-7D-001" },
            "adapter_code": { "const": "WNF7-ADAPTER-SIDEKICK_OEL-001" },
            "operation_code": { "enum": ["WORK_ITEM_INTAKE", "DELEGATION_REVIEW", "OUTCOME_REVIEW"] }
          }
        },
        {
          "properties": {
            "component_code": { "const": "SOURCECOIN" },
            "profile_code": { "const": "SOURCECOIN-PROFILE-7D-001" },
            "adapter_code": { "const": "WNF7-ADAPTER-SOURCECOIN-001" },
            "operation_code": { "enum": ["ECONOMIC_ELIGIBILITY", "TRANSFER_ELIGIBILITY", "SETTLEMENT_ELIGIBILITY"] }
          }
        },
        {
          "properties": {
            "component_code": { "const": "SOURCEBLOCK" },
            "profile_code": { "const": "SOURCEBLOCK-PROFILE-7D-001" },
            "adapter_code": { "const": "WNF7-ADAPTER-SOURCEBLOCK-001" },
            "operation_code": { "enum": ["LIFECYCLE_GATE", "VALUE_EVIDENCE_REVIEW", "CLOSURE_REVIEW"] }
          }
        }
      ]
    }
  ],
  "$defs": {
    "dimensionCode": {
      "enum": [
        "FEAR",
        "PRESENCE",
        "WISDOM",
        "KNOWLEDGE",
        "UNDERSTANDING",
        "COUNSEL",
        "MIGHT_POWER"
      ]
    },
    "dimensionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "status",
        "finding",
        "evidence_refs",
        "control_refs",
        "owner_role",
        "reviewed_at"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/dimensionCode"
        },
        "status": {
          "enum": [
            "PASS",
            "REVIEW",
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "control_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner_role": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "not_applicable_reason": {
          "type": "string",
          "minLength": 1
        },
        "approving_authority_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_APPLICABLE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "not_applicable_reason",
              "approving_authority_ref"
            ]
          }
        }
      ]
    }
  }
}
