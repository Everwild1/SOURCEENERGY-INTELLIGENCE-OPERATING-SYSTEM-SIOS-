{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourceenergy.tech/schemas/ssr/anchor-tile-roster.schema.json",
  "title": "SSR AnchorTile Roster Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchor_tile_id",
    "w3w_address",
    "latitude",
    "longitude",
    "activation_date",
    "source_system"
  ],
  "properties": {
    "anchor_tile_id": {"type": "string", "minLength": 1},
    "w3w_address": {
      "type": "string",
      "pattern": "^///[A-Za-z0-9-]+\\.[A-Za-z0-9-]+\\.[A-Za-z0-9-]+$"
    },
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "activation_date": {"type": "string", "format": "date-time"},
    "status": {"type": "string"},
    "surface_crs": {"type": "string", "default": "EPSG:4326"},
    "vertical_datum": {"type": ["string", "null"]},
    "source_system": {"type": "string", "minLength": 1},
    "source_record_id": {"type": ["string", "null"]},
    "source_exported_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
